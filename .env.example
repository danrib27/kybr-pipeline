AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DEBUG, INFO (default), WARNING or ERROR. `-v` forces DEBUG.
LOG_LEVEL=

# RustFS (local S3) for dev. Defaults to rustfsadmin when empty.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Bucket that rustfs-init creates. Defaults to the one in config.yaml.
S3_BUCKET=
# Point `make run` at RustFS instead of AWS (use the RustFS keys above
# as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
# AWS_ENDPOINT_URL=http://localhost:9000
